    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Student/Instructors",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sakibul Amin\",\n  \"email\": \"info.sakibulamin@gmail.com\",\n  \"password\": \"Sakib@123\",\n  \"role\":\"STUDENT\"\n \n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://university-management-system-weld.vercel.app/api/v1/auth/register",
              "protocol": "https",
              "host": [
                "university-management-system-weld",
                "vercel",
                "app"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Public. Sends OTP to email; account not created until verified."
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {\n    const json = pm.response.json();\n    if (json.data && json.data.accessToken) {\n        pm.collectionVariables.set(\"accessToken\", json.data.accessToken);\n    }\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meet.sakibulamin@gmail.com\",\n  \"otp\": \"164665\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "description": "Public. Creates the User + Student, returns tokens."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.accessToken) {",
                  "        pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
