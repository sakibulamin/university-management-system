{
  "name": "university-management-system",
  "version": "1.0.0",
  "description": "University Management System API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
 "dev": "tsx watch src/server.ts",
  "build": "tsup",
  "start": "node dist/server.js",
  "seed": "tsx prisma/seed.ts",
  "format:check": "npx @biomejs/biome format ./src",
  "format:fix": "npx @biomejs/biome format --write ./src",
  "lint:check": "npx @biomejs/biome lint ./src",
  "lint:fix": "npx @biomejs/biome lint --write ./src"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "js-crypto-random": "^1.0.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "redis": "^6.2.1",
    "tsup": "^8.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
