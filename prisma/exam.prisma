

// ==================== EXAM ====================

model Exam {
  id String @id @default(uuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  title      String
  examType   ExamType
  totalMarks Float
  examDate   DateTime

  results Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([sectionId])
  @@index([examType])
  @@index([examDate])
  @@index([deletedAt])
  @@map("exams")
}
