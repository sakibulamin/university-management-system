
model Course {
	id           String  @id @default(uuid())
	name         String
	code         String  @unique
	credits      Int
	description  String?
	departmentId String?

	isDeleted Boolean   @default(false)
	deletedAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	department Department? @relation(fields: [departmentId], references: [id])

	prerequisites CoursePrerequisite[] @relation("CourseRequiresPrerequisite")
	requiredFor   CoursePrerequisite[] @relation("PrerequisiteRequiredByCourse")

	@@index([departmentId])
}
