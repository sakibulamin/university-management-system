// Phase 3: Complete database schema.
// Business services and API routes are NOT implemented in this phase.

generator client {
	provider = "prisma-client-js"
	output   = "../src/generated/prisma"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

// ==========================================================================
// ENUMS
// ==========================================================================

enum Role {
	STUDENT
	INSTRUCTOR
	ADMIN
}

enum AuthProvider {
	CREDENTIAL
	GOOGLE
}

enum UserStatus {
	ACTIVE
	BLOCKED
	DELETED
}

enum SemesterStatus {
	UPCOMING
	ACTIVE
	COMPLETED
}

enum EnrollmentStatus {
	ACTIVE
	CANCELLED
	COMPLETED
}

enum AttendanceStatus {
	PRESENT
	ABSENT
	LATE
}

enum ExamType {
	QUIZ
	MIDTERM
	FINAL
}

enum Grade {
	A_PLUS
	A
	A_MINUS
	B_PLUS
	B
	B_MINUS
	C_PLUS
	C
	D
	F
}

enum PaymentStatus {
	PENDING
	PAID
	FAILED
	CANCELLED
}

enum PaymentGateway {
	BKASH
}

// ==========================================================================
// AUTHENTICATION & USER
// ==========================================================================

model User {
	id            String       @id @default(uuid())
	name          String
	email         String       @unique
	password      String?
	role          Role
	status        UserStatus   @default(ACTIVE)
	authProvider  AuthProvider @default(CREDENTIAL)
	googleId      String?      @unique
	emailVerified Boolean      @default(false)

	isDeleted Boolean   @default(false)
	deletedAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	student       Student?
	instructor    Instructor?
	refreshTokens RefreshToken[]
	auditLogs     AuditLog[]

	@@index([role])
	@@index([status])
}

model RefreshToken {
	id        String    @id @default(uuid())
	userId    String
	tokenHash String    @unique
	expiresAt DateTime
	revokedAt DateTime?

	createdAt DateTime @default(now())

	user User @relation(fields: [userId], references: [id])

	@@index([userId])
}

// ==========================================================================
// USER PROFILES
// ==========================================================================

model Student {
	id           String    @id @default(uuid())
	userId       String    @unique
	studentId    String    @unique
	programId    String
	phone        String?
	address      String?
	dateOfBirth  DateTime?
	profileImage String?

	isDeleted Boolean   @default(false)
	deletedAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	user        User         @relation(fields: [userId], references: [id])
	program     Program      @relation(fields: [programId], references: [id])
	enrollments Enrollment[]
	payments    Payment[]

	@@index([programId])
}

model Instructor {
	id           String  @id @default(uuid())
	userId       String  @unique
	instructorId String  @unique
	departmentId String
	designation  String?
	phone        String?
	profileImage String?

	isDeleted Boolean   @default(false)
	deletedAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	user       User       @relation(fields: [userId], references: [id])
	department Department @relation(fields: [departmentId], references: [id])
	sections   Section[]

	@@index([departmentId])
}

// ==========================================================================
// ACADEMIC STRUCTURE
// ==========================================================================

model Department {
	id   String @id @default(uuid())
	name String
	code String @unique

	isDeleted Boolean   @default(false)
	deletedAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	programs    Program[]
	courses     Course[]
	instructors Instructor[]
}

model Program {
	id           String @id @default(uuid())
	name         String
	code         String @unique
	departmentId String

	isDeleted Boolean   @default(false)
	deletedAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	department Department @relation(fields: [departmentId], references: [id])
	students   Student[]

	@@index([departmentId])
}

model Course {
	id           String  @id @default(uuid())
	name         String
	code         String  @unique
	credits      Int
	description  String?
	departmentId String?

	isDeleted Boolean   @default(false)
	deletedAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	department Department? @relation(fields: [departmentId], references: [id])
	sections   Section[]

	// Prerequisites this course requires
	prerequisites CoursePrerequisite[] @relation("CourseRequiresPrerequisite")
	// Courses that require this course as a prerequisite
	requiredFor   CoursePrerequisite[] @relation("PrerequisiteRequiredByCourse")

	@@index([departmentId])
}

model CoursePrerequisite {
	id                   String @id @default(uuid())
	courseId             String
	prerequisiteCourseId String

	createdAt DateTime @default(now())

	course             Course @relation("CourseRequiresPrerequisite", fields: [courseId], references: [id])
	prerequisiteCourse Course @relation("PrerequisiteRequiredByCourse", fields: [prerequisiteCourseId], references: [id])

	@@unique([courseId, prerequisiteCourseId])
}

model Semester {
	id        String         @id @default(uuid())
	name      String         @unique
	startDate DateTime
	endDate   DateTime
	status    SemesterStatus @default(UPCOMING)

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	sections Section[]

	@@index([status])
}

model Section {
	id           String  @id @default(uuid())
	courseId     String
	semesterId   String
	instructorId String
	sectionCode  String
	capacity     Int
	schedule     String?

	isDeleted Boolean   @default(false)
	deletedAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	course     Course     @relation(fields: [courseId], references: [id])
	semester   Semester   @relation(fields: [semesterId], references: [id])
	instructor Instructor @relation(fields: [instructorId], references: [id])

	enrollments Enrollment[]
	exams       Exam[]

	@@unique([courseId, semesterId, sectionCode])
	@@index([courseId])
	@@index([semesterId])
	@@index([instructorId])
}

// ==========================================================================
// ACADEMIC OPERATIONS
// ==========================================================================

model Enrollment {
	id          String           @id @default(uuid())
	studentId   String
	sectionId   String
	status      EnrollmentStatus @default(ACTIVE)
	enrolledAt  DateTime         @default(now())
	cancelledAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	student Student @relation(fields: [studentId], references: [id])
	section Section @relation(fields: [sectionId], references: [id])

	attendances Attendance[]
	results     Result[]

	@@unique([studentId, sectionId])
	@@index([studentId])
	@@index([sectionId])
}

model Attendance {
	id           String           @id @default(uuid())
	enrollmentId String
	date         DateTime         @db.Date
	status       AttendanceStatus

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

	@@unique([enrollmentId, date])
	@@index([enrollmentId])
}

model Exam {
	id         String   @id @default(uuid())
	sectionId  String
	title      String
	type       ExamType
	totalMarks Int
	examDate   DateTime

	isDeleted Boolean   @default(false)
	deletedAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	section Section  @relation(fields: [sectionId], references: [id])
	results Result[]

	@@index([sectionId])
}

model Result {
	id            String    @id @default(uuid())
	enrollmentId  String
	examId        String
	obtainedMarks Float
	grade         Grade
	gradePoint    Float
	publishedAt   DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
	exam       Exam       @relation(fields: [examId], references: [id])

	@@unique([enrollmentId, examId])
	@@index([enrollmentId])
	@@index([examId])
}

// ==========================================================================
// PAYMENT (bKash only — schema designed for real bKash flow in Phase 11)
// ==========================================================================

model Payment {
	id      String         @id @default(uuid())
	studentId String
	amount    Float
	currency  String         @default("BDT")
	status    PaymentStatus  @default(PENDING)
	gateway   PaymentGateway @default(BKASH)

	merchantInvoiceNumber String  @unique
	bkashPaymentID        String? @unique
	bkashTrxID            String? @unique
	payerReference        String?
	customerMsisdn        String?

	createResponse  Json?
	executeResponse Json?
	failureReason   String?

	initiatedAt DateTime  @default(now())
	paidAt      DateTime?
	cancelledAt DateTime?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	student Student @relation(fields: [studentId], references: [id])

	@@index([studentId])
	@@index([status])
}

// ==========================================================================
// ADMINISTRATION
// ==========================================================================

model AuditLog {
	id       String  @id @default(uuid())
	userId   String?
	action   String
	entity   String
	entityId String
	details  Json?

	createdAt DateTime @default(now())

	user User? @relation(fields: [userId], references: [id])

	@@index([userId])
	@@index([entity, entityId])
}
